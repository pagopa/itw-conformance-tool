{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig*.json"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.js"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/vitest.config.ts"
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "cache": true
    },
    "test:e2e": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": false
    },
    "format": {
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/vitest.e2e.config.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "analytics": false
}