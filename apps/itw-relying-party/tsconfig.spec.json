{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "paths": {
      "@itw-conformance-tool/conformance": ["../../packages/conformance/dist/index.d.ts"],
      "@itw-conformance-tool/database": ["../../packages/database/dist/index.d.ts"],
      "@itw-conformance-tool/logger": ["../../packages/logger/dist/index.d.ts"],
      "@itw-conformance-tool/rp": ["../../packages/rp/dist/index.d.ts"]
    }
  },
  "include": [
    "src/app.ts",
    "src/plugins/**/*.ts",
    "src/routes/**/*.ts",
    "src/tests/**/*.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "../../packages/conformance/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rp/tsconfig.lib.json"
    },
    {
      "path": "../../packages/logger/tsconfig.lib.json"
    },
    {
      "path": "../../packages/database/tsconfig.lib.json"
    }
  ]
}
