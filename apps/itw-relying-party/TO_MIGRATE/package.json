    "@fastify/websocket": "^11.0.2",
    "dcql": "^0.2.22",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "5.9.6",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/jwk-to-pem": "^2",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:",
