{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "paths": {
      "#/*": ["./src/*"],
      "@itw-conformance-tool/config": ["../../packages/config/dist/index.d.ts"],
      "@itw-conformance-tool/conformance": ["../../packages/conformance/dist/index.d.ts"],
      "@itw-conformance-tool/crypto": ["../../packages/crypto/dist/index.d.ts"],
      "@itw-conformance-tool/database": ["../../packages/database/dist/index.d.ts"],
      "@itw-conformance-tool/issuer": ["../../packages/issuer/dist/index.d.ts"],
      "@itw-conformance-tool/logger": ["../../packages/logger/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "eslint.config.js",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../../packages/config/tsconfig.lib.json"
    },
    {
      "path": "../../packages/conformance/tsconfig.lib.json"
    },
    {
      "path": "../../packages/logger/tsconfig.lib.json"
    },
    {
      "path": "../../packages/crypto/tsconfig.lib.json"
    },
    {
      "path": "../../packages/issuer/tsconfig.lib.json"
    },
    {
      "path": "../../packages/database/tsconfig.lib.json"
    }
  ]
}
