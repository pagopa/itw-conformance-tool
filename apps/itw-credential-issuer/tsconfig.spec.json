{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"]
  },
  "include": [
    "src/app.ts",
    "src/plugins/**/*.ts",
    "src/routes/**/*.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts"
  ],
  "references": [
    {
      "path": "../../packages/logger/tsconfig.lib.json"
    },
    {
      "path": "../../packages/issuer/tsconfig.lib.json"
    },
    {
      "path": "../../packages/database/tsconfig.lib.json"
    }
  ]
}
