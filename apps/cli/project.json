{
  "name": "itw-conformance-cli",
  "typecheck": {
    "executor": "nx:run-commands",
    "dependsOn": ["^typecheck"],
    "options": {
      "cwd": "apps/cli",
      "command": "tsc --noEmit -p tsconfig.app.json"
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "apps/cli/dist",
        "format": ["esm"],
        "bundle": false,
        "main": "apps/cli/src/main.ts",
        "tsConfig": "apps/cli/tsconfig.app.json",
        "assets": [],
        "esbuildOptions": {
          "banner": { "js": "#!/usr/bin/env node" },
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "generateLockfile": true,
          "esbuildOptions": {
            "banner": { "js": "#!/usr/bin/env node" },
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "run": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "itw-conformance-cli:build",
        "runBuildTargetDependencies": false,
        "watch": false,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "itw-conformance-cli:build:development",
          "watch": false,
          "inspect": false
        },
        "production": {
          "buildTarget": "itw-conformance-cli:build:production",
          "watch": false,
          "inspect": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/cli/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/cli/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "apps/cli/test-reports"
      }
    }
  }
}
