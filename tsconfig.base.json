{
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@itw-conformance-tool/logger": ["./packages/logger/src/index.ts"],
      "@itw-conformance-tool/database": ["./packages/database/src/index.ts"]
    },
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["itw-conformance-tool"],
    "verbatimModuleSyntax": true
  }
}
