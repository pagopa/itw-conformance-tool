{
  "name": "itw-conformance-tool",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "scripts": {
    "start": "nx run-many -t serve",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "NODE_OPTIONS='--max-listeners=30' nx run-many -t test",
    "init": "nx run itw-conformance-cli:run --args init",
    "init:force": "nx run itw-conformance-cli:run --args \"init --force\"",
    "test:all": "nx run itw-conformance-cli:run --args test",
    "test:issuance": "nx run itw-conformance-cli:run --args=\"test issuance\"",
    "test:presentation": "nx run itw-conformance-cli:run --args=\"test presentation\"",
    "test:wallet-instance": "nx run itw-conformance-cli:run --args=\"test wallet-instance\"",
    "test:wallet-provider": "nx run itw-conformance-cli:run --args=\"test wallet-provider\"",
    "format": "prettier --write '**/*.{js,mjs,json,ts,mts,md}'",
    "format:check": "prettier --check '**/*.{js,mjs,json,ts,mts,md}'",
    "clean": "nx run-many -t clean && rimraf node_modules .nx",
    "pre-commit": "pnpm format:check && nx affected -t lint typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/docker": "22.7.0",
    "@nx/esbuild": "22.7.0",
    "@nx/eslint": "22.7.0",
    "@nx/eslint-plugin": "22.7.0",
    "@nx/js": "22.7.0",
    "@nx/node": "22.7.0",
    "@nx/vitest": "22.7.0",
    "@nx/workspace": "22.7.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "catalog:node",
    "@vitest/coverage-v8": "~4.1.0",
    "eslint": "^9.26.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tslib": "^2.3.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "catalog:"
  }
}
