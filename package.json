{
  "name": "itw-conformance-tool",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "nx run-many -t serve",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test --projects itw-credential-issuer,itw-relying-party",
    "conformance": "pnpm nx run itw-conformance-cli:build && node apps/cli/dist/main.js",
    "conformance:issuance": "pnpm conformance issuance",
    "conformance:presentation": "pnpm conformance presentation",
    "format": "prettier --write '**/*.{js,mjs,json,ts,mts,md}'",
    "clean": "nx run-many -t clean && rimraf node_modules .nx",
    "pre-commit": "nx affected -t lint typecheck",
    "prepare": "husky",
    "issuer": "nx serve itw-credential-issuer",
    "rp": "nx serve itw-relying-party"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/docker": "22.7.0",
    "@nx/esbuild": "22.7.0",
    "@nx/eslint": "22.7.0",
    "@nx/eslint-plugin": "22.7.0",
    "@nx/js": "22.7.0",
    "@nx/node": "22.7.0",
    "@nx/vitest": "22.7.0",
    "@nx/workspace": "22.7.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "catalog:node",
    "@vitest/coverage-v8": "~4.1.0",
    "eslint": "^9.26.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tslib": "^2.3.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  }
}
