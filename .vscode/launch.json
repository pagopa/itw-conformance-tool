{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Credential Issuer",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "itw-credential-issuer"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/itw-credential-issuer/dist/**/*.(m|c|)js", "!**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Relying Party",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "itw-relying-party"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/itw-relying-party/dist/**/*.(m|c|)js", "!**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Trust Anchor",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "itw-trust-anchor"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/itw-trust-anchor/dist/**/*.(m|c|)js", "!**/node_modules/**"]
    }
  ]
}
